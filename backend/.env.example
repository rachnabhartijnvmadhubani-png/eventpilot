# Copy to .env, set the database URL, and never commit real secrets.
DATABASE_URL=mysql+pymysql://eventpilot:CHANGE_ME@localhost:3306/eventpilot
# Private server maintenance only. People sign up and log in with email/password.
ORGANIZER_API_KEY=replace-with-a-long-random-secret-before-running
# Preserve this setting on an existing installation for legacy data and rollback.
# New organization signup and login do not require organization access keys.
ORGANIZATION_KEY_ENCRYPTION_KEY=
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
# Notifications queue safely until SMTP is configured; delivery failures can be retried.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME_GMAIL_ADDRESS
SMTP_FROM_EMAIL=CHANGE_ME_GMAIL_ADDRESS
SMTP_APP_PASSWORD=CHANGE_ME_APP_PASSWORD
SMTP_STARTTLS=true
PUBLIC_APP_URL=http://3.110.130.114:8080

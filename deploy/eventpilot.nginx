# AWS public hostnames exceed the default name-hash bucket on this host.
server_names_hash_bucket_size 128;

server {
    listen 80;
    listen [::]:80;
    # Alternate HTTP endpoint for networks or browsers that fail on port 80.
    listen 8080;
    listen [::]:8080;
    server_name 3.110.130.114 ec2-3-110-130-114.ap-south-1.compute.amazonaws.com;

    root /var/www/eventpilot;
    index index.html;
    client_max_body_size 1m;
    add_header X-Content-Type-Options nosniff always;

    location / {
        try_files $uri $uri/ =404;
        add_header Cache-Control "no-cache";
    }

    location ~ ^/(api(?:/|$)|docs(?:/|$)|docs-assets(?:/|$)|redoc(?:/|$)|openapi\.json$) {
        proxy_pass http://127.0.0.1:8001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 90s;
    }

    location ~ /\. {
        deny all;
    }
}
